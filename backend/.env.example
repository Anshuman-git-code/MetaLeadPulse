# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variable template
#
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git — it contains secrets.
# This file (.env.example) IS committed — it shows what variables are needed
# without exposing the actual values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Meta Developer App ────────────────────────────────────────────────────────
# Found in: Meta Developer Dashboard → Your App → Settings → Basic

# The numeric App ID of your Meta Developer App
META_APP_ID=

# The App Secret — used to verify webhook payload signatures (X-Hub-Signature-256)
# Keep this private — never expose it in client-side code or logs
META_APP_SECRET=

# ── Webhook verification ──────────────────────────────────────────────────────
# A string you choose yourself — can be any random string
# You enter the same value in Meta Developer Dashboard → Webhooks → Verify Token
# Meta sends it back during webhook verification so we can confirm the request is from Meta
META_VERIFY_TOKEN=

# ── Facebook Page ─────────────────────────────────────────────────────────────
# The numeric ID of the Facebook Page associated with the Lead Form
# Found in: Facebook Page → About, or via Graph API Explorer
META_PAGE_ID=

# ── Meta Graph API access ─────────────────────────────────────────────────────
# Page Access Token with leads_retrieval + pages_manage_metadata permissions
# Used to subscribe the Page to webhook events and to retrieve lead data
# Generate via: Meta Developer Dashboard → Graph API Explorer → Get Page Token
# For PoC: a long-lived Page Access Token is sufficient
META_PAGE_ACCESS_TOKEN=
